#include <AccelStepper.h>

// Stepper controller for the von Mises experiment.
// Serial @ 115200. Commands: ? for the list.
//
// SAFETY (why this boots the way it does):
//   - Boots IDLE and DISABLED. The motor will NOT move on power-up, on a
//     board reset, or when the laptop sleeps/wakes (which resets the board
//     over USB). You must press 't' to run.
//   - Stray/buffered serial bytes right after boot are flushed and ignored
//     for a short window, so a sleep/wake reconnect can't inject a command.
//   Hardware safety (do these too -- firmware alone is not enough):
//   - Put a physical switch on the motor's DC power to the driver. Off = it
//     cannot spin no matter what. Make that your default resting state.
//   - 10uF cap RESET->GND on the Arduino kills USB auto-reset (remove to upload).
//   - 10k pull-downs on STEP and DIR so they don't float during a reset.

const int STEP_PIN = 12;
const int DIR_PIN  = 13;
const int EN_PIN   = 11;

AccelStepper stepper(AccelStepper::DRIVER, STEP_PIN, DIR_PIN);
float baseSpeed = 500;
float baseAccel = 1000;

float impulseSpeed = 4000;
float impulseAccel = 8000;
long targetPos = 1000000000L;

// boot IDLE + DISABLED -- nothing moves until you arm it with 't'
bool running = false;
bool enabled = false;
int direction = 1;

bool impulseActive = false;
unsigned long impulseStart = 0;
unsigned long impulseDuration = 200;

// ignore any serial that arrives in the first bit after boot (sleep/wake
// reconnects can dump stray bytes that would otherwise run as commands)
const unsigned long BOOT_QUIET_MS = 800;
unsigned long bootQuietUntil = 0;

void setup() {
  Serial.begin(115200);
  pinMode(EN_PIN, OUTPUT);
  digitalWrite(EN_PIN, HIGH);          // driver DISABLED (de-energized) on boot
  stepper.setMaxSpeed(baseSpeed);
  stepper.setAcceleration(baseAccel);
  // NOTE: no moveTo() here on purpose -- arming the target in setup is what
  // made it take off on boot. The target is set when you press 't'.
  bootQuietUntil = millis() + BOOT_QUIET_MS;
  while (Serial.available()) Serial.read();   // flush junk from the reconnect
  Serial.println("READY - press t to start (boots idle + disabled)");
}

void loop() {

  if (running && enabled) {
    stepper.run();
  }

  // during the boot-quiet window, drain and ignore any serial
  if (millis() < bootQuietUntil) {
    while (Serial.available()) Serial.read();
    return;
  }

// serial block begin (hard stop, kill, direction, impulse, reverse)
  if (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') return;

    if (c == 't') {
      running = !running;
      if (running) {
        enabled = true;                // arm enable together with run
        digitalWrite(EN_PIN, LOW);
        stepper.moveTo(direction * targetPos);
        Serial.println("RUN");
      } else {
        stepper.stop();
        Serial.println("STOP");
      }
    }

    if (c == 'h') {
      enabled = !enabled;
      if (enabled) {
        digitalWrite(EN_PIN, LOW);
        Serial.println("ON");
      } else {
        digitalWrite(EN_PIN, HIGH);
        Serial.println("OFF");
      }
    }

    if (c == 'd') {
      direction *= -1;
      stepper.moveTo(direction * targetPos);
      Serial.println("DIR");
    }

    if (c == '+') {
      baseSpeed += 200;
      stepper.setMaxSpeed(baseSpeed);
      Serial.println(baseSpeed);
    }

    if (c == '-') {
      baseSpeed -= 200;
      if (baseSpeed < 100) baseSpeed = 100;
      stepper.setMaxSpeed(baseSpeed);
      Serial.println(baseSpeed);
    }
if (c == '?') {
  Serial.println("t: run/stop");
  Serial.println("h: enable toggle");
  Serial.println("k: kill");
  Serial.println("d: direction");
  Serial.println("r: reverse impulse");
  Serial.println("+: speed up");
  Serial.println("-: speed down");
  Serial.println("]: accel up");
  Serial.println("[: accel down");
  Serial.println("i: impulse");
}
    if (c == 'i') {
      impulseActive = true;
      impulseStart = millis();
      stepper.setMaxSpeed(impulseSpeed);
      stepper.setAcceleration(impulseAccel);
      Serial.println("IMPULSE");
    }

    if (c == ']') {
      baseAccel += 500;
      stepper.setAcceleration(baseAccel);
      Serial.println(baseAccel);
    }

    if (c == '[') {
      baseAccel -= 500;
      if (baseAccel < 100) baseAccel = 100;
      stepper.setAcceleration(baseAccel);
      Serial.println(baseAccel);
    }

    if (c == 'k') {
      enabled = false;
      running = false;
      digitalWrite(EN_PIN, HIGH);
      Serial.println("KILL");
    }

    if (c == 'r') {
      impulseActive = true;
      impulseStart = millis();
      stepper.setAcceleration(20000);
      direction *= -1;
      stepper.moveTo(direction * targetPos);
      Serial.println("REV");
    }
  }

  if (impulseActive && millis() - impulseStart > impulseDuration) {
    impulseActive = false;
    stepper.setMaxSpeed(baseSpeed);
    stepper.setAcceleration(baseAccel);
    Serial.println("NORMAL");
  }
}
