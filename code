#include <FastAccelStepper.h>

// Stepper controller for the von Mises experiment -- FastAccelStepper version.
// Stepping is generated by a HARDWARE TIMER (interrupt), so the pulse train is
// rock-steady and reaches far higher step rates than software AccelStepper.
// loop() no longer touches the motor -- it only reads serial.
//
// PINS (Mega 2560):
//   STEP = 12  -> OC1B, a Timer1 pin. FastAccelStepper needs STEP on a timer
//                 pin; 12 already is one, so this lead does NOT move.
//   DIR  = 9   -> MOVED off Timer1 (was 13). plain output.
//   EN   = 8   -> MOVED off Timer1 (was 11). plain output, active-low.
//   (DIR/EN moved so the library's Timer1 takeover can't touch them.)
//
// SAFETY (same as before): boots IDLE + DISABLED, no spin on power-up / reset /
// laptop sleep-wake; stray serial right after boot is flushed + ignored.
// Still add the hardware safeties: switch on the motor DC power, 10uF RESET->GND
// cap to kill USB auto-reset, pull-downs on STEP/DIR.
//
// Serial @ 115200. Commands: ? for the list.

const int STEP_PIN = 12;
const int DIR_PIN  = 9;
const int EN_PIN   = 8;

FastAccelStepperEngine engine = FastAccelStepperEngine();
FastAccelStepper *stepper = NULL;

float baseSpeed = 500;      // steps/s (Hz)
float baseAccel = 1000;     // steps/s^2
float impulseSpeed = 4000;
float impulseAccel = 8000;

bool running = false;       // boot IDLE
bool enabled = false;       // boot DISABLED
int  direction = 1;         // +1 forward, -1 backward

bool impulseActive = false;
unsigned long impulseStart = 0;
unsigned long impulseDuration = 200;

const unsigned long BOOT_QUIET_MS = 800;
unsigned long bootQuietUntil = 0;

// push current speed/accel to the stepper, and (re)issue the run so changes
// take effect immediately while spinning
void drive() {
  if (!stepper) return;
  stepper->setSpeedInHz((uint32_t)baseSpeed);
  stepper->setAcceleration((uint32_t)baseAccel);
  if (running) {
    if (direction > 0) stepper->runForward();
    else               stepper->runBackward();
  }
}

void setup() {
  Serial.begin(115200);
  engine.init();
  stepper = engine.stepperConnectToPin(STEP_PIN);
  if (stepper) {
    stepper->setDirectionPin(DIR_PIN);
    stepper->setEnablePin(EN_PIN, /*active_low=*/true);
    stepper->setAutoEnable(false);     // we manage enable, to boot disabled
    stepper->disableOutputs();         // DISABLED on boot
    stepper->setSpeedInHz((uint32_t)baseSpeed);
    stepper->setAcceleration((uint32_t)baseAccel);
  }
  bootQuietUntil = millis() + BOOT_QUIET_MS;
  while (Serial.available()) Serial.read();   // flush junk from USB reconnect
  Serial.println("READY - press t to start (boots idle + disabled)");
}

void loop() {
  // no stepper.run() -- stepping runs in the background off the timer ISR

  // ignore any serial during the boot-quiet window (sleep/wake can dump bytes)
  if (millis() < bootQuietUntil) {
    while (Serial.available()) Serial.read();
    return;
  }

  if (Serial.available()) {
    char c = Serial.read();

    if (c != '\n' && c != '\r') {
      if (c == 't') {
        running = !running;
        if (running) {
          enabled = true;
          stepper->enableOutputs();
          drive();
          Serial.println("RUN");
        } else {
          stepper->stopMove();          // decelerate to a stop
          Serial.println("STOP");
        }
      }

      else if (c == 'h') {
        enabled = !enabled;
        if (enabled) { stepper->enableOutputs();  Serial.println("ON"); }
        else         { stepper->disableOutputs(); Serial.println("OFF"); }
      }

      else if (c == 'd') {
        direction *= -1;
        drive();                         // re-issue in the new direction if running
        Serial.println("DIR");
      }

      else if (c == '+') {
        baseSpeed += 200;
        drive();
        Serial.println(baseSpeed);
      }

      else if (c == '-') {
        baseSpeed -= 200;
        if (baseSpeed < 100) baseSpeed = 100;
        drive();
        Serial.println(baseSpeed);
      }

      else if (c == '?') {
        Serial.println("t: run/stop");
        Serial.println("h: enable toggle");
        Serial.println("k: kill");
        Serial.println("d: direction");
        Serial.println("r: reverse impulse");
        Serial.println("+: speed up");
        Serial.println("-: speed down");
        Serial.println("]: accel up");
        Serial.println("[: accel down");
        Serial.println("i: impulse");
      }

      else if (c == 'i') {
        impulseActive = true;
        impulseStart = millis();
        stepper->setSpeedInHz((uint32_t)impulseSpeed);
        stepper->setAcceleration((uint32_t)impulseAccel);
        if (running) {
          if (direction > 0) stepper->runForward(); else stepper->runBackward();
        }
        Serial.println("IMPULSE");
      }

      else if (c == ']') {
        baseAccel += 500;
        drive();
        Serial.println(baseAccel);
      }

      else if (c == '[') {
        baseAccel -= 500;
        if (baseAccel < 100) baseAccel = 100;
        drive();
        Serial.println(baseAccel);
      }

      else if (c == 'k') {
        enabled = false;
        running = false;
        stepper->forceStop();            // immediate stop
        stepper->disableOutputs();
        Serial.println("KILL");
      }

      else if (c == 'r') {
        impulseActive = true;
        impulseStart = millis();
        direction *= -1;
        stepper->setAcceleration(20000);
        if (running) {
          if (direction > 0) stepper->runForward(); else stepper->runBackward();
        }
        Serial.println("REV");
      }
    }
  }

  // revert impulse/reverse back to the base speed + accel after the window
  if (impulseActive && millis() - impulseStart > impulseDuration) {
    impulseActive = false;
    drive();                             // restores baseSpeed/baseAccel
    Serial.println("NORMAL");
  }
}
